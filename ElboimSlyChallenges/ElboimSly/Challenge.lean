section
open MeasureTheory Filter Topology
open scoped ENNReal NNReal
variable (d : ℕ) (β : ℝ)
variable [Fact (0 < β)]
variable {d β}
/-- A `ν`-ring path of length `n` in `I`: vertices `v₀, …, vₙ`, strictly increasing times
`t₁ < ⋯ < tₙ` in `I`, such that the edge `{v_{i-1}, v_i}` rings at `t_i`.
Ring paths. -/
@[expose] def IsRingPath (ν : Measure (RingSpace d β)) (I : Set ℝ) (n : ℕ)
    (v : Fin (n + 1) → (Fin d → ℤ)) (t : Fin n → ℝ) : Prop :=
  StrictMono t ∧ (∀ i, t i ∈ I) ∧
    ∀ i : Fin n, ∃ e : Edge d, e.1 = s(v i.castSucc, v i.succ) ∧ Rings ν e (t i)
end

section
open MeasureTheory Filter Topology
open scoped ENNReal NNReal
/-- The interval `I_j = [jβ/4, jβ/4 + β/2]`. Ring paths. -/
@[expose] def ringWindow (β : ℝ) (j : ℤ) : Set ℝ := Set.Icc (j * β / 4) (j * β / 4 + β / 2)
end

section
open MeasureTheory Filter Topology
open scoped ENNReal NNReal
variable (d : ℕ) (β : ℝ)
variable [Fact (0 < β)]
variable {d β}
/-- Good configurations (G1)–(G3). Good configurations. -/
@[expose] def Good (ν : Measure (RingSpace d β)) : Prop :=
  IsRingConfig ν ∧
  -- (G1)
  (∀ e : Edge d, ν ({e} ×ˢ Set.univ) < ∞) ∧
  -- (G2)
  ((∀ e θ, ν {(e, θ)} ≤ 1) ∧ ∀ e f : Edge d, e ≠ f → Disjoint (ringSet ν e) (ringSet ν f)) ∧
  -- (G3)
  ∀ (y : Fin d → ℤ) (j : ℤ), ∃ n : ℕ,
    (¬ ∃ (v : Fin (n + 1) → (Fin d → ℤ)) (t : Fin n → ℝ),
        v 0 = y ∧ IsRingPath ν (ringWindow β j) n v t) ∧
    (¬ ∃ (v : Fin (n + 1) → (Fin d → ℤ)) (t : Fin n → ℝ),
        v (Fin.last n) = y ∧ IsRingPath ν (ringWindow β j) n v t)
end

section
open MeasureTheory Filter Topology
open scoped ENNReal NNReal
variable (d : ℕ) (β : ℝ)
variable [Fact (0 < β)]
variable {d β}
/-- Existence and uniqueness of forward and backward trajectories for good configurations: the
well-definedness theorem of D16. In the half-line encoding of `IsForwardPath` and
`IsBackwardPath`, `γ s` is the position at time `a + s` and `η s` the position at time `b - s`.
Existence and uniqueness of trajectories, first two sentences only. The third sentence (a `ν`-path on `[a, b]`
is determined by its value at `a`, and also by its value at `b`) is not part of this statement. -/
theorem existsUnique_trajectories (ν : Measure (RingSpace d β)) (hν : Good ν) :
    (∀ (x : Fin d → ℤ) (a : ℝ), ∃! γ : ℝ≥0 → Fin d → ℤ, IsForwardTrajectory ν x a γ) ∧
    (∀ (y : Fin d → ℤ) (b : ℝ), ∃! η : ℝ≥0 → Fin d → ℤ, IsBackwardTrajectory ν y b η) :=
  sorry
end

section
open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal
/-- The extended Poisson law on `[0, ∞]`. Extended Poisson law.
For `a < ∞` it is the image of `poissonMeasure a` under `ℕ → [0, ∞]`; for `a = ∞` it is `δ_∞`.
(The case split is the definition in the source, not a fallback.) -/
@[expose] noncomputable def extPoissonMeasure (a : ℝ≥0∞) : Measure ℝ≥0∞ :=
  if a = ∞ then Measure.dirac ∞
  else (poissonMeasure a.toNNReal).map (Nat.cast : ℕ → ℝ≥0∞)
end

section
open MeasureTheory
open scoped NNReal
variable {d : ℕ} {β : ℝ} [Fact (0 < β)]
open scoped Classical in
/-- The interchange map `π_s = π_s^ν`: for good `ν`, the position at time `s` of the particle
that starts at `x` at time `0` (the forward trajectory from `(x, 0)`, chosen from the proved
`existsUnique_trajectories`); for `ν` not good, the identity. Interchange permutation. -/
@[expose] noncomputable def interchangePi (ν : Measure (RingSpace d β)) (s : ℝ≥0) (x : Fin d → ℤ) :
    Fin d → ℤ :=
  if hν : Good ν then
    (Classical.choose ((existsUnique_trajectories ν hν).1 x 0).exists) s
  else x
end

section
open MeasureTheory
open scoped NNReal
variable (d : ℕ) (β : ℝ) [Fact (0 < β)]
/-- `Fin₀ = {ν good : ∃ k ≥ 1, π_β^k 0 = 0}`: the good configurations in which the
`π_β`-cycle of the origin is finite. The two target events. -/
@[expose] def finZeroEvent : Set (Measure (RingSpace d β)) :=
  {ν | Good ν ∧ ∃ k : ℕ, 1 ≤ k ∧ (interchangePi ν β.toNNReal)^[k] 0 = 0}
end

section
/-- The exponent `δ := 1 / (3000 d²)` (`= ε / (10 d)` with `ε = 1 / (300 d)`).
Constants, scales, failure bounds. The constant `ε` is used by no statement in gate G1 and is not defined. -/
@[expose] noncomputable def indDelta (d : ℕ) : ℝ := 1 / (3000 * (d : ℝ) ^ 2)
end

section
/-- The time scale `t_n := 4ⁿ t₀`. Constants, scales, failure bounds. The written proof's restriction
`t₀ ∈ (1, 4]` sits on the quantifier in `IndHyp` and the main theorem, not on this function. -/
@[expose] noncomputable def indScale (t₀ : ℝ) (n : ℕ) : ℝ := 4 ^ n * t₀
end

section
/-- The failure bound `p_n(β, t₀)`: `exp(-n³)` if `t_n < β`, and `exp(-n²)` if `t_n ≥ β`.
Constants, scales, failure bounds. The case split is the source's definition. -/
@[expose] noncomputable def indFailBound (β t₀ : ℝ) (n : ℕ) : ℝ :=
  if indScale t₀ n < β then Real.exp (-((n : ℝ) ^ 3)) else Real.exp (-((n : ℝ) ^ 2))
end

section
open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal
/-- `N` is a Poisson point process with intensity `μ` on the probability space `(Ω, P)`.
Poisson point process (with random measures for measurability in the Giry
`σ`-algebra `Measure.instMeasurableSpace`).
* `Measurable N`: `N` is a random measure.
* (PPP1) every count `N(A)` has the extended Poisson law of mean `μ A`
  (so `N A = ∞` almost surely when `μ A = ∞`).
* (PPP2) for pairwise disjoint measurable `A 0, …, A (n-1)` the joint law of the counts is the
  product of the extended Poisson laws (equivalently, the counts are independent).
Taking `n = 0` in (PPP2) forces `P` to be a probability measure. -/
@[expose] def IsPoissonPointProcess {Ω S : Type*} [MeasurableSpace Ω] [MeasurableSpace S]
    (N : Ω → Measure S) (μ : Measure S) (P : Measure Ω) : Prop :=
  Measurable N ∧
  (∀ A : Set S, MeasurableSet A → P.map (fun ω => N ω A) = extPoissonMeasure (μ A)) ∧
  (∀ (n : ℕ) (A : Fin n → Set S), (∀ j, MeasurableSet (A j)) →
    Pairwise (Function.onFun Disjoint A) →
    P.map (fun ω j => N ω (A j)) = Measure.pi (fun j => extPoissonMeasure (μ (A j))))
end

section
/-- The visited set `V_{[a,t]}(w) := {w(s) : a ≤ s ≤ t}`. Visited set, heavy block. -/
@[expose] def visitedSet {d : ℕ} (w : ℝ → Fin d → ℤ) (a t : ℝ) : Set (Fin d → ℤ) :=
  w '' Set.Icc a t
end

section
/-- The block `B(x, r) = {v : ‖v - x‖ ≤ r}` (closed `ℓ∞` box, ES22 §3) is *heavy for `w` on
`[a, t]`*: `|B(x,r) ∩ V_{[a,t]}(w)| ≥ r^{5/2}`, for real `r > 0`. Visited set, heavy block.
`|·|` on vertex sets is cardinality (reading choices (c)); the intersection is finite. -/
@[expose] def IsHeavy {d : ℕ} (w : ℝ → Fin d → ℤ) (a t : ℝ) (x : Fin d → ℤ) (r : ℝ) : Prop :=
  0 < r ∧ r ^ (5 / 2 : ℝ) ≤ (({v : Fin d → ℤ | ‖v - x‖ ≤ r} ∩ visitedSet w a t).ncard : ℝ)
end

section
/-- The time `t` is *relaxed with respect to `w|[a,t]`*:
(R1) for every real `r ≥ β^δ`, the block `B(w(t), r)` is not heavy for `w` on `[a, t]`;
(R2) `‖w(t) - w(s)‖ ≥ β^δ` for every `s ∈ [a, t - β^{3δ}]`.
Relaxed times, with `δ = indDelta d` and real powers `β ^ δ`. -/
@[expose] noncomputable def IsRelaxedTimeWrt {d : ℕ} (β : ℝ) (w : ℝ → Fin d → ℤ) (a t : ℝ) :
    Prop :=
  (∀ r : ℝ, β ^ indDelta d ≤ r → ¬ IsHeavy w a t (w t) r) ∧
  (∀ s : ℝ, a ≤ s → s ≤ t - β ^ (3 * indDelta d) → β ^ indDelta d ≤ ‖w t - w s‖)
end

section
open scoped ENNReal
variable {d : ℕ} {β : ℝ} [Fact (0 < β)]
/-- The regeneration times `σ_0 := 0`, `σ_i := ∑_{j ≤ i} t_reg^{(j)}`, in `ℝ≥0∞`. The environment of
piece `j` is `ν (j - 1)`, so `regenSigma ν i = ∑_{k < i} cycTreg (ν k)`. Regenerated cyclic walk. -/
@[expose] noncomputable def regenSigma (ν : ℕ → MeasureTheory.Measure (RingSpace d β)) (i : ℕ) :
    ℝ≥0∞ :=
  ∑ k ∈ Finset.range i, cycTreg (ν k)
end

section
variable {d : ℕ} {β : ℝ} [Fact (0 < β)]
/-- `𝔑_t := max {i : σ_i ≤ t}`, the number of completed pieces by time `t`. The set is nonempty (`i = 0`)
and bounded (`σ_i ≥ iβ`) for `t ≥ 0`, so `sSup` is its maximum. Regenerated cyclic walk. -/
@[expose] noncomputable def regenCount (ν : ℕ → MeasureTheory.Measure (RingSpace d β)) (t : ℝ) : ℕ :=
  sSup {i : ℕ | regenSigma ν i ≤ ENNReal.ofReal t}
end

section
variable {d : ℕ} {β : ℝ} [Fact (0 < β)]
/-- `α(t) := σ_{𝔑_t}`, the last regeneration time at or before `t` (real-valued; finite since
`σ_{𝔑_t} ≤ t`). Regenerated cyclic walk. -/
@[expose] noncomputable def regenStart (ν : ℕ → MeasureTheory.Measure (RingSpace d β)) (t : ℝ) : ℝ :=
  (regenSigma ν (regenCount ν t)).toReal
end

section
variable {d : ℕ} {β : ℝ} [Fact (0 < β)]
/-- The regenerated cyclic walk built from the environments `ν 0, ν 1, …` (piece `k + 1` uses `ν k`):
`W(s) := W^{(i)}(s - σ_{i-1})` for `s ∈ [σ_{i-1}, σ_i)`. With `𝔑_t = i - 1` this is
`cycWalk (ν 𝔑_t) 0 0 (t - α(t))`. If `t_reg^{(i)} = ∞` then `σ_i = ∞` and `W` follows `W^{(i)}`
forever, as in the source. Only `t ≥ 0` is meaningful. Regenerated cyclic walk (construction (i),
from i.i.d. environments; the constructions of the regenerated walk shows the other constructions have the same law). -/
@[expose] noncomputable def regenWalk (ν : ℕ → MeasureTheory.Measure (RingSpace d β)) (t : ℝ) :
    Fin d → ℤ :=
  cycWalk (ν (regenCount ν t)) 0 0 (t - regenStart ν t)
end

section
variable {d : ℕ} {β : ℝ} [Fact (0 < β)]
/-- For the regenerated walk, `t` is *relaxed* if it is relaxed with respect to `W|[α(t), t]`.
Relaxed times. -/
@[expose] noncomputable def IsRelaxedTime (ν : ℕ → MeasureTheory.Measure (RingSpace d β)) (t : ℝ) :
    Prop :=
  IsRelaxedTimeWrt β (regenWalk ν) (regenStart ν t) t
end

section
/-- The scale index `n(t) := ⌈log₄ t⌉ - 1` of a real `t > 1`, so that `t ∈ (4^{n(t)}, 4^{n(t)+1}]`
and `t_n` has `n(t_n) = n`. Constants, scales, failure bounds. Natural subtraction is harmless: it is
used only for `t > 1`, where `⌈log₄ t⌉ ≥ 1`. -/
@[expose] noncomputable def scaleIndex (t : ℝ) : ℕ := ⌈Real.logb 4 t⌉₊ - 1
end

section
open MeasureTheory
variable {d : ℕ} {β : ℝ} [Fact (0 < β)]
/-- The regenerated walk on `[0, t]` is a *relaxed path*: `|𝒯 ∩ [0, t]| ≥ (0.9 + 1/n) t`, where
`n = n(t)` is `scaleIndex t`, `𝒯` is the set of relaxed times (`IsRelaxedTime`) and `|·|` is Lebesgue
measure (reading choices (c)). For `1 ≤ n ≤ 9` this is impossible, as in the source (Sanity); for
`n = 0` Lean's `1/0 = 0` turns it into `0.9 t ≤ |𝒯 ∩ [0,t]|`, a case no G1 statement evaluates (G1
uses only `t = t_n`, `n ≥ 10`). The relative notion along `w|[a, a+t]` is not used by gate G1 and is
not defined. Relaxed path. -/
@[expose] noncomputable def IsRelaxedPath (ν : ℕ → Measure (RingSpace d β)) (t : ℝ) : Prop :=
  ENNReal.ofReal ((9 / 10 + 1 / (scaleIndex t : ℝ)) * t) ≤
    volume {s : ℝ | s ∈ Set.Icc 0 t ∧ IsRelaxedTime ν s}
end

section
open MeasureTheory Filter Topology
open scoped ENNReal NNReal
variable (d : ℕ) (β : ℝ)
variable [Fact (0 < β)]
/-- The intensity `μ_β = # ⊗ Leb_β` on `S_β`; `volume` on `AddCircle β` is Haar measure of total
mass `β`. Ring configurations. -/
@[expose] noncomputable def ringIntensity : Measure (RingSpace d β) :=
  Measure.count.prod (volume : Measure (AddCircle β))
end

section
open MeasureTheory
variable {Ω : Type*} [MeasurableSpace Ω] {d : ℕ} {β : ℝ} [Fact (0 < β)]
/-- (H1) (relaxed paths): `ℙ(W|[0, t_n] is a relaxed path) ≥ 1 - p_n`, for the regenerated walk built
from the copies `copyEnv (N ω) k`. The hypotheses mathbf H(β,n,t_0) (H1). -/
@[expose] noncomputable def IndH1 (P : Measure Ω) (N : Ω → Measure (ℕ × RingSpace d β)) (n : ℕ)
    (t₀ : ℝ) : Prop :=
  ENNReal.ofReal (1 - indFailBound β t₀ n) ≤
    P {ω | IsRelaxedPath (fun k => copyEnv (N ω) k) (indScale t₀ n)}
end

section
open MeasureTheory
variable {Ω : Type*} [MeasurableSpace Ω] {d : ℕ} {β : ℝ} [Fact (0 < β)]
/-- (H2) (transition probabilities): `ℙ(W(t) = u) ≤ t^{-d/2 + 0.1}` for all real `t ∈ [1, t_n]` and all
`u ∈ ℤ^d`. The hypotheses mathbf H(β,n,t_0) (H2). -/
@[expose] noncomputable def IndH2 (P : Measure Ω) (N : Ω → Measure (ℕ × RingSpace d β)) (n : ℕ)
    (t₀ : ℝ) : Prop :=
  ∀ t : ℝ, t ∈ Set.Icc 1 (indScale t₀ n) → ∀ u : Fin d → ℤ,
    P {ω | regenWalk (fun k => copyEnv (N ω) k) t = u} ≤
      ENNReal.ofReal (t ^ (-(d : ℝ) / 2 + 1 / 10))
end

section
open MeasureTheory
variable {Ω : Type*} [MeasurableSpace Ω] {d : ℕ} {β : ℝ} [Fact (0 < β)]
/-- (H3) (travelling far): `ℙ(sup_{s ≤ t_n} ‖W(s)‖ ≥ n² √t_n) ≤ p_n`, the supremum over `s ∈ [0, t_n]`
taken in `[0, ∞]`. The hypotheses mathbf H(β,n,t_0) (H3). -/
@[expose] noncomputable def IndH3 (P : Measure Ω) (N : Ω → Measure (ℕ × RingSpace d β)) (n : ℕ)
    (t₀ : ℝ) : Prop :=
  P {ω | ENNReal.ofReal ((n : ℝ) ^ 2 * Real.sqrt (indScale t₀ n)) ≤
      ⨆ s : Set.Icc (0 : ℝ) (indScale t₀ n),
        ENNReal.ofReal ‖regenWalk (fun k => copyEnv (N ω) k) (s : ℝ)‖} ≤
    ENNReal.ofReal (indFailBound β t₀ n)
end

section
/-- The (H4) exponent `θ_H := 41/100`. **Deviation D11:** ES22 (ES22 §3) has `2/5`.
Constants, scales, failure bounds. -/
@[expose] noncomputable def indThetaH : ℝ := 41 / 100
end

section
open MeasureTheory
open scoped NNReal
variable {Ω : Type*} [MeasurableSpace Ω] {d : ℕ} {β : ℝ} [Fact (0 < β)]
/-- (H4) (approximately Brownian): there is `σ` with `|σ - √2| ≤ max {3 β^{-1/16} - t_n^{-1/16}, 0}`
such that the law of `W|[0, t_n]` (on the product `σ`-algebra of `[0, t_n] → ℤ^d`; the walk is a
measurable path map by measurability) admits a `(σ, t_n^{θ_H})`-coupling up to time `t_n` with
failure probability `p_n`, in the joint-law sense of `AdmitsBMCoupling`.
**Deviation D11:** the error is `t_n^{θ_H}`, `θ_H = 41/100`, not ES22's `t_n^{2/5}`.
**Deviation F22 / D5:** `ℓ∞` norms. The hypotheses mathbf H(β,n,t_0) (H4). -/
@[expose] noncomputable def IndH4 (P : Measure Ω) (N : Ω → Measure (ℕ × RingSpace d β)) (n : ℕ)
    (t₀ : ℝ) : Prop :=
  ∃ σ : ℝ, |σ - Real.sqrt 2| ≤ max (3 * β ^ (-(1 : ℝ) / 16) - indScale t₀ n ^ (-(1 : ℝ) / 16)) 0 ∧
    AdmitsBMCoupling d (indScale t₀ n).toNNReal
      (P.map (fun ω (t : Set.Icc (0 : ℝ≥0) (indScale t₀ n).toNNReal) =>
        regenWalk (fun k => copyEnv (N ω) k) ((t : ℝ≥0) : ℝ)))
      σ (indScale t₀ n ^ indThetaH) (indFailBound β t₀ n)
end

section
/-- The reduced time scale `t'_n := t_n / n⁴` (the written proof uses it for `n ≥ 1`).
Constants, scales, failure bounds. -/
@[expose] noncomputable def indScaleReduced (t₀ : ℝ) (n : ℕ) : ℝ := indScale t₀ n / (n : ℝ) ^ 4
end

section
open MeasureTheory
variable {Ω : Type*} [MeasurableSpace Ω] {d : ℕ} {β : ℝ} [Fact (0 < β)]
/-- (H5) (pair proximity), in one environment `N` that is *not* regenerated: for all `u₁, u₂ ∈ ℤ^d` and
`q₁, q₂ ∈ [0, β]` (reading choices (a)),
`ℙ(Ω(u₁,u₂,q₁,q₂;t'_n) ∩ {|𝔓_n| ≥ 3.9^n}) ≤ p_n`, where
`𝔓_n = {s₂ ∈ [0,t'_n] : ∃ s₁ ∈ [0,t'_n], ‖W₁(s₁) - W₂(s₂)‖ ≤ 1.9^n}`, `W_i = W^N_{u_i,q_i}`, and `|𝔓_n|` is
Lebesgue measure (reading choices (c)). The hypotheses mathbf H(β,n,t_0) (H5). -/
@[expose] noncomputable def IndH5 (P : Measure Ω) (N : Ω → Measure (RingSpace d β)) (n : ℕ)
    (t₀ : ℝ) : Prop :=
  ∀ (u₁ u₂ : Fin d → ℤ) (q₁ q₂ : ℝ), q₁ ∈ Set.Icc 0 β → q₂ ∈ Set.Icc 0 β →
    P {ω | cycOmega (N ω) u₁ u₂ q₁ q₂ (indScaleReduced t₀ n) ∧
        ENNReal.ofReal ((39 / 10 : ℝ) ^ n) ≤
          volume {s₂ : ℝ | s₂ ∈ Set.Icc 0 (indScaleReduced t₀ n) ∧
            ∃ s₁ ∈ Set.Icc 0 (indScaleReduced t₀ n),
              ‖cycWalk (N ω) u₁ q₁ s₁ - cycWalk (N ω) u₂ q₂ s₂‖ ≤ (19 / 10 : ℝ) ^ n}} ≤
      ENNReal.ofReal (indFailBound β t₀ n)
end

section
open MeasureTheory
/-- The hypotheses `H(β, n, t₀)` in dimension `d`: (H1)-(H4) for the regenerated walk built from the
copies of a Poisson point process `N` of intensity `# ⊗ μ_β` on `ℕ × S_β` (the constructions of the regenerated walk (i)),
and (H5) for a Poisson point process `N` of intensity `μ_β` on `S_β` (one environment, not
regenerated), each on every probability space `(Ω, P)` of universe 0 (the statements depend only on
the law). The hypotheses mathbf H(β,n,t_0). -/
@[expose] noncomputable def IndHyp (d : ℕ) (β : ℝ) [Fact (0 < β)] (n : ℕ) (t₀ : ℝ) : Prop :=
  (∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) (N : Ω → Measure (ℕ × RingSpace d β)),
      IsPoissonPointProcess N ((Measure.count : Measure ℕ).prod (ringIntensity d β)) P →
        IndH1 P N n t₀ ∧ IndH2 P N n t₀ ∧ IndH3 P N n t₀ ∧ IndH4 P N n t₀) ∧
  (∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) (N : Ω → Measure (RingSpace d β)),
      IsPoissonPointProcess N (ringIntensity d β) P → IndH5 P N n t₀)
end

section
open MeasureTheory
open scoped NNReal
variable (d : ℕ) (β : ℝ) [Fact (0 < β)]
/-- `Inf = {ν good : ∃ x, ∀ k ≥ 1, π_β^k x ≠ x}`: the good configurations with an infinite
`π_β`-cycle. The two target events. -/
@[expose] def infEvent : Set (Measure (RingSpace d β)) :=
  {ν | Good ν ∧ ∃ x : Fin d → ℤ, ∀ k : ℕ, 1 ≤ k → (interchangePi ν β.toNNReal)^[k] x ≠ x}
end

end ElboimSly.Challenge

