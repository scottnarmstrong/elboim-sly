section
open MeasureTheory ProbabilityTheory
open scoped NNReal
/-- `𝕎` is Wiener measure on `C([0, ∞), ℝ^d)` (Borel `σ`-algebra of the compact-open topology,
`ContinuousMap.measurableSpace`): a probability measure under which each coordinate process
`(t, w) ↦ w t i` is pre-Brownian (Mathlib's `IsPreBrownianReal`; (BM2) of standard d-dimensional Brownian motion) and the `d`
coordinate processes are mutually independent ((BM3)). (BM0) and the continuity part of (BM1) hold
for every element of `C([0, ∞), ℝ^d)`. The condition `w 0 = 0` holds `𝕎`-almost surely
(`IsPreBrownianReal.eval_zero_ae_eq_zero`); it is not, and cannot be, demanded for every `w`, since
the canonical space contains paths with `w 0 ≠ 0`. The finite-dimensional laws are thereby fixed,
and they determine `𝕎`, because the Borel `σ`-algebra of `C([0, ∞), ℝ^d)` is generated by the
evaluations (`ContinuousMap.borel_eq_iSup_comap_eval`). Standard d-dimensional Brownian motion; The law of Brownian motion (b). -/
@[expose] def IsWienerMeasure (d : ℕ) (𝕎 : Measure C(ℝ≥0, Fin d → ℝ)) : Prop :=
  IsProbabilityMeasure 𝕎 ∧
  (∀ i, IsPreBrownianReal (fun t (w : C(ℝ≥0, Fin d → ℝ)) => w t i) 𝕎) ∧
  iIndepFun (fun i (w : C(ℝ≥0, Fin d → ℝ)) t => w t i) 𝕎
end

section
open scoped NNReal
/-- The walk path space on `[0, T]`: the right-continuous, piecewise-constant paths
`w : [0, T] → ℤ^d` with finitely many jumps, i.e. there is a finite set `F` of jump times such that
`w s = w u` whenever `s ≤ u` and no element of `F` lies in `(s, u]`. The `σ`-algebra is the one induced
from the product (cylinder) `σ`-algebra on `[0,T] → ℤ^d`, as in the source ("law on the cylinder
`σ`-algebra"). Brownian coupling at a time, D17. -/
@[reducible, expose] def WalkPath (d : ℕ) (T : ℝ≥0) : Type :=
  {w : Set.Icc (0 : ℝ≥0) T → Fin d → ℤ //
    ∃ F : Finset ℝ≥0, ∀ s u : Set.Icc (0 : ℝ≥0) T, s ≤ u → (∀ r ∈ F, ¬ ((s : ℝ≥0) < r ∧ r ≤ u)) →
      w s = w u}
end

section
open MeasureTheory
open scoped NNReal ENNReal
/-- The walk law `lawW` (a measure on the product space `[0,T] → ℤ^d`) *admits a `(σ, ε)`-coupling up
to time `T` with failure probability `η`* (**D17, joint law**): there is a probability measure
`Q` on `WalkPath d T × C([0, ∞), ℝ^d)` whose first marginal, viewed in `[0,T] → ℤ^d`, is `lawW`, whose
second marginal is Wiener measure, and with
`Q (sup_{t ∈ [0,T]} ‖W̃(t) - σ B(t)‖ ≥ ε) ≤ η`, where `‖·‖` is the sup norm (D5, F22) and the supremum is
taken in `[0, ∞]`. On `WalkPath` the supremum equals the one over `([0,T] ∩ ℚ) ∪ {T}`, so the event
is measurable, as in the source remark. Brownian coupling at a time. -/
@[expose] noncomputable def AdmitsBMCoupling (d : ℕ) (T : ℝ≥0)
    (lawW : Measure (Set.Icc (0 : ℝ≥0) T → Fin d → ℤ)) (σ ε η : ℝ) : Prop :=
  ∃ Q : Measure (WalkPath d T × C(ℝ≥0, Fin d → ℝ)),
    IsProbabilityMeasure Q ∧ Q.map (fun p => p.1.1) = lawW ∧ IsWienerMeasure d (Q.map Prod.snd) ∧
    Q {p | ENNReal.ofReal ε ≤
        ⨆ t : Set.Icc (0 : ℝ≥0) T,
          ENNReal.ofReal ‖(fun i => ((p.1.1 t i : ℤ) : ℝ)) - σ • p.2 (t : ℝ≥0)‖} ≤ ENNReal.ofReal η
end

