ν-paths. -/
@[expose] def IsForwardTrajectory (ν : Measure (RingSpace d β)) (x : Fin d → ℤ) (a : ℝ)
    (γ : ℝ≥0 → Fin d → ℤ) : Prop :=
  IsForwardPath ν a γ ∧ γ 0 = x
end

section
open scoped NNReal
variable {d : ℕ} {β : ℝ} [Fact (0 < β)]
/-- The cyclic walk `W^ν_{u,q}` started at `u` at cyclic time `q`, as a function of `s : ℝ`.
Cyclic walk. In the half-line encoding of the frozen trajectories (`γ s` is the position
at time `q + s`, `η s` the position at time `q - s`):
`W^ν_{u,q}(s) = γ^ν_{u,q}(q+s)` for `s ≥ 0` is `γ s`, and `W^ν_{u,q}(s) = η^ν_{u,q}(q+s)` for `s ≤ 0`
is `η (-s)`. Following D16, `γ` and `η` are the trajectories of `IsForwardTrajectory ν u q`
and `IsBackwardTrajectory ν u q`, chosen with `Classical.epsilon`. On `Good ν` they exist and are
unique (`ElboimSly.existsUnique_trajectories`), so the choice is the trajectory. Off `Good ν`
the value is an arbitrary junk value that no statement uses (the environments are a.s. good). -/
@[expose] noncomputable def cycWalk (ν : MeasureTheory.Measure (RingSpace d β)) (u : Fin d → ℤ)
    (q : ℝ) (s : ℝ) : Fin d → ℤ :=
  if 0 ≤ s then
    Classical.epsilon (fun γ : ℝ≥0 → Fin d → ℤ => IsForwardTrajectory ν u q γ) s.toNNReal
  else
    Classical.epsilon (fun η : ℝ≥0 → Fin d → ℤ => IsBackwardTrajectory ν u q η) (-s).toNNReal
end

section
variable {d : ℕ} {β : ℝ} [Fact (0 < β)]
/-- `W_{u,q}` *closes by time* `t'`: `W_{u,q}(s) = u` for some `s ∈ βℤ ∩ (0, t']`.
Closing time; Reading choices (b). -/
@[expose] def cycClosesBy (ν : MeasureTheory.Measure (RingSpace d β)) (u : Fin d → ℤ) (q t' : ℝ) :
    Prop :=
  ∃ k : ℕ, 1 ≤ k ∧ (k : ℝ) * β ≤ t' ∧ cycWalk ν u q ((k : ℝ) * β) = u
end

section
variable {d : ℕ} {β : ℝ} [Fact (0 < β)]
/-- The walks `W_1 := W_{u₁,q₁}` and `W_2 := W_{u₂,q₂}` *merge by time* `t'`: there are
`s₁, s₂ ∈ [0, t']` with `(s₁ + q₁) - (s₂ + q₂) ∈ βℤ` and `W₁(s₁) = W₂(s₂)`.
Merging of two walks. -/
@[expose] def cycMerges (ν : MeasureTheory.Measure (RingSpace d β)) (u₁ u₂ : Fin d → ℤ)
    (q₁ q₂ t' : ℝ) : Prop :=
  ∃ s₁ s₂ : ℝ, s₁ ∈ Set.Icc 0 t' ∧ s₂ ∈ Set.Icc 0 t' ∧
    (∃ k : ℤ, (s₁ + q₁) - (s₂ + q₂) = (k : ℝ) * β) ∧ cycWalk ν u₁ q₁ s₁ = cycWalk ν u₂ q₂ s₂
end

section
variable {d : ℕ} {β : ℝ} [Fact (0 < β)]
/-- The event `Ω(u₁, u₂, q₁, q₂; t')`, as a predicate of the environment `ν`: the walks `W_{u₁,q₁}` and
`W_{u₂,q₂}` do not merge by time `t'` and neither closes by time `t'`. Merging of two walks. -/
@[expose] def cycOmega (ν : MeasureTheory.Measure (RingSpace d β)) (u₁ u₂ : Fin d → ℤ)
    (q₁ q₂ t' : ℝ) : Prop :=
  ¬ cycMerges ν u₁ u₂ q₁ q₂ t' ∧ ¬ cycClosesBy ν u₁ q₁ t' ∧ ¬ cycClosesBy ν u₂ q₂ t'
end

section
open scoped ENNReal
variable {d : ℕ} {β : ℝ} [Fact (0 < β)]
/-- The closing time `t_reg := inf {k β : k ∈ ℤ_{≥1}, W(kβ) = 0} ∈ βℤ_{≥1} ∪ {∞}` of the cyclic walk
`W = W^ν_{0,0}`. Closing time. Values in `ℝ≥0∞`; the infimum over the empty set is `∞`. -/
@[expose] noncomputable def cycTreg (ν : MeasureTheory.Measure (RingSpace d β)) : ℝ≥0∞ :=
  ⨅ k : {k : ℕ // 1 ≤ k ∧ cycWalk ν 0 0 ((k : ℝ) * β) = 0}, ENNReal.ofReal ((k.1 : ℝ) * β)
end

