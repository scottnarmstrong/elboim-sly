module

public import Mathlib.MeasureTheory.Measure.GiryMonad
import Mathlib

/-!
# Measurability on the space of measures

Random measures; Measurability on pppM(S).

A random measure is a measurable map into `Measure S` with Mathlib's `Measure.instMeasurableSpace`
(generated by the evaluations). This file proves the measurability facts (a)-(f) of measurability on pppM(S)
(mostly by naming Mathlib results) and (g): count events form a `π`-system generating the
`σ`-algebra.
-/

@[expose] public section

open MeasureTheory
open scoped ENNReal

namespace ElboimSly

variable {S S' Θ : Type*} [MeasurableSpace S] [MeasurableSpace S'] [MeasurableSpace Θ]

/-- Measurability on pppM(S) (a). -/
theorem measurable_measure_iff {f : Θ → Measure S} :
    Measurable f ↔ ∀ A, MeasurableSet A → Measurable fun θ => f θ A :=
  ⟨fun h _A hA => (Measure.measurable_coe hA).comp h,
    fun h => Measure.measurable_of_measurable_coe f h⟩

/-- Measurability on pppM(S) (b). -/
theorem measurable_lintegral_measure {g : S → ℝ≥0∞} (hg : Measurable g) :
    Measurable fun ν : Measure S => ∫⁻ x, g x ∂ν :=
  Measure.measurable_lintegral hg

/-- Measurability on pppM(S) (c), addition. -/
theorem measurable_add_measure : Measurable fun p : Measure S × Measure S => p.1 + p.2 :=
  measurable_fst.add measurable_snd

/-- Measurability on pppM(S) (c), countable sums. -/
theorem measurable_measure_sum {ι : Type*} [Countable ι] {f : ι → Θ → Measure S}
    (hf : ∀ i, Measurable (f i)) : Measurable fun θ => Measure.sum fun i => f i θ := by
  rw [measurable_measure_iff]
  intro A hA
  simp_rw [Measure.sum_apply _ hA]
  exact Measurable.tsum fun i => (Measure.measurable_coe hA).comp (hf i)

/-- Measurability on pppM(S) (d). -/
theorem measurable_map_measure {φ : S → S'} (hφ : Measurable φ) :
    Measurable fun ν : Measure S => ν.map φ :=
  Measure.measurable_map φ hφ

/-- Measurability on pppM(S) (e). -/
theorem measurable_restrict_measure {A : Set S} (hA : MeasurableSet A) :
    Measurable fun ν : Measure S => ν.restrict A := by
  rw [measurable_measure_iff]
  intro B hB
  simp_rw [Measure.restrict_apply hB]
  exact Measure.measurable_coe (hB.inter hA)

/-- The family of count events `{ν | (ν(B₁),…,ν(B_l)) ∈ C}` (Measurability on pppM(S) (g)).
Difference from the written proof: `l = 0` is allowed; this adds only `∅` and the whole space. -/
def countEvents (S : Type*) [MeasurableSpace S] : Set (Set (Measure S)) :=
  {F | ∃ (l : ℕ) (B : Fin l → Set S) (C : Set (Fin l → ℝ≥0∞)),
    (∀ i, MeasurableSet (B i)) ∧ MeasurableSet C ∧ F = {ν | (fun i => ν (B i)) ∈ C}}

theorem measurable_countVec {l : ℕ} {B : Fin l → Set S} (hB : ∀ i, MeasurableSet (B i)) :
    Measurable fun ν : Measure S => fun i => ν (B i) :=
  Measurable.of_eval fun i => Measure.measurable_coe (hB i)

theorem countEvents_measurableSet {F : Set (Measure S)} (hF : F ∈ countEvents S) :
    MeasurableSet F := by
  obtain ⟨l, B, C, hB, hC, rfl⟩ := hF
  exact measurable_countVec hB hC

theorem univ_mem_countEvents : (Set.univ : Set (Measure S)) ∈ countEvents S :=
  ⟨1, fun _ => Set.univ, Set.univ, fun _ => MeasurableSet.univ, MeasurableSet.univ, by simp⟩

theorem isPiSystem_countEvents : IsPiSystem (countEvents S) := by
  rintro _ ⟨l, B, C, hB, hC, rfl⟩ _ ⟨l', B', C', hB', hC', rfl⟩ -
  refine ⟨l + l', Fin.append B B', {x | (fun i => x (Fin.castAdd l' i)) ∈ C ∧
    (fun j => x (Fin.natAdd l j)) ∈ C'}, ?_, ?_, ?_⟩
  · intro i
    refine Fin.addCases (fun i => ?_) (fun j => ?_) i <;> simp [hB, hB']
  · exact (hC.preimage (Measurable.of_eval fun i => measurable_pi_apply _)).inter
      (hC'.preimage (Measurable.of_eval fun i => measurable_pi_apply _))
  · ext ν
    simp [Fin.append_left, Fin.append_right]

/-- Measurability on pppM(S) (g): the count events generate the `σ`-algebra of `Measure S`. -/
theorem generateFrom_countEvents :
    MeasurableSpace.generateFrom (countEvents S) =
      (Measure.instMeasurableSpace : MeasurableSpace (Measure S)) := by
  apply le_antisymm
  · exact MeasurableSpace.generateFrom_le fun F hF => countEvents_measurableSet hF
  · refine iSup_le fun s => iSup_le fun hs => ?_
    rw [MeasurableSpace.comap_le_iff_le_map]
    intro C hC
    refine MeasurableSpace.measurableSet_generateFrom ?_
    refine ⟨1, fun _ => s, {x | x 0 ∈ C}, fun _ => hs, ?_, ?_⟩
    · exact (measurable_pi_apply 0) hC
    · ext ν; simp

end ElboimSly
