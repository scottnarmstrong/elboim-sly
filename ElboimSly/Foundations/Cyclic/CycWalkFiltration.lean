module

public import ElboimSly.Foundations.Cyclic.CycLines
public import ElboimSly.Frozen.Defs.CycWalk
public import Mathlib

/-!
# The natural filtration of the cyclic walk

Natural filtration. For a random environment `N : Ω → Measure (RingSpace d β)` the
cyclic walk is `W(s)(ω) = cycWalk (N ω) 0 0 s` (junk off the good environments, as in `cycWalk`),
and `ℱ^W_t = σ(W(s) : 0 ≤ s ≤ t) ∨ 𝒩` where `𝒩 = cycNull P` is generated by the `P`-null sets of
the ambient σ-algebra. It is named `cycWalkFiltration`, distinct from the plan's joint filtration
`cycFiltration`.
-/

@[expose] public section

open MeasureTheory
open scoped NNReal

namespace ElboimSly.Cyclic

variable {d : ℕ} {β : ℝ} [Fact (0 < β)] {Ω : Type*} [mΩ : MeasurableSpace Ω]

/-- **natural filtration**: `ℱ^W_t = σ(W(s) : 0 ≤ s ≤ t) ∨ 𝒩`, `W = W^{N}_{0,0}` the cyclic walk
of the environment `N`. -/
@[instance_reducible] noncomputable def cycWalkFiltration (P : Measure Ω)
    (N : Ω → Measure (RingSpace d β)) (t : ℝ≥0) : MeasurableSpace Ω :=
  (⨆ s : ℝ≥0, ⨆ _ : s ≤ t, MeasurableSpace.comap
      (fun ω => ElboimSly.cycWalk (N ω) 0 0 (s : ℝ)) inferInstance) ⊔ cycNull P

omit [Fact (0 < β)] in
theorem cycWalkFiltration_mono (P : Measure Ω) (N : Ω → Measure (RingSpace d β)) :
    Monotone (cycWalkFiltration P N) := by
  intro a b hab
  refine sup_le_sup_right ?_ _
  refine iSup_le fun s => iSup_le fun hs => ?_
  exact le_iSup_of_le s (le_iSup_of_le (hs.trans hab) le_rfl)

omit [Fact (0 < β)] in
theorem cycWalkFiltration_le_ambient (P : Measure Ω) (N : Ω → Measure (RingSpace d β))
    (hW : ∀ s : ℝ≥0, Measurable fun ω => ElboimSly.cycWalk (N ω) 0 0 (s : ℝ)) (t : ℝ≥0) :
    cycWalkFiltration P N t ≤ mΩ :=
  sup_le (iSup₂_le fun s _ => (hW s).comap_le)
    (MeasurableSpace.generateFrom_le fun _ hA => hA.1)

end ElboimSly.Cyclic

end
