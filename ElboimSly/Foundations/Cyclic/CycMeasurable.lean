public import ElboimSly.Foundations.Cyclic.CycClosing
public import ElboimSly.Foundations.Interchange.LawInvariance
import Mathlib

/-!
# Measurability (measurability)

Measurability.

Configurations carry the σ-algebra generated by `ν ↦ ν(A)` (the one of `Measure`).

* `measurableSet_good`: `Good` is measurable (in `GoodMeas`).
* `measurable_fwdTraj`: `(ν, a, r) ↦ γ^ν_{x,a}(r)` is measurable on `Good`.
* `measurable_trajProc`: `ν ↦ trajProc ν x a`, into `ℝ≥0 → ℤᵈ` with the product σ-algebra.
* `measurable_interchangePi`, `measurable_piBeta_iterate`: `π_s`, `π_β^k` are measurable on `Good`.
* `measurableSet_finZeroEvent`, `measurableSet_infEvent`: the events `Fin₀` and `Inf`.
* `measurable_cycWalk`: `W^ν_{u,q}(s)` for `s ≥ 0` is measurable on `Good`.
* `measurableSet_cycTreg_le`: the events `{good, t_reg ≤ t}`.
-/

@[expose] public section

open MeasureTheory Set ElboimSly.Interchange
open scoped ENNReal NNReal

namespace ElboimSly.Cyclic

variable {d : ℕ} {β : ℝ} [Fact (0 < β)]

/-- `(ν, a, r) ↦ γ^ν_{x,a}(r)` is measurable on the good configurations. -/
theorem measurable_fwdTraj (x : Fin d → ℤ) :
    Measurable (fun q : GoodSet d β × ℝ × ℝ => fwdTraj q.1.2 x q.2.1 q.2.2) := by
  refine measurable_to_countable' fun y => ?_
  have hF : ∀ k, Measurable (fun q : GoodSet d β × ℝ × ℝ => fseq q.1.1 x q.2.1 k) := fun k =>
    (measurable_fseq x k).comp (measurable_fst.prodMk (measurable_fst.comp measurable_snd))
  have hM : Measurable (fun q : GoodSet d β × ℝ × ℝ => max q.2.2 q.2.1) :=
    (measurable_snd.comp measurable_snd).max (measurable_fst.comp measurable_snd)
  have : (fun q : GoodSet d β × ℝ × ℝ => fwdTraj q.1.2 x q.2.1 q.2.2) ⁻¹' {y} =
      ⋃ k : ℕ, ({q | (fseq q.1.1 x q.2.1 k).1 ≤ max q.2.2 q.2.1} ∩
        {q | max q.2.2 q.2.1 < (fseq q.1.1 x q.2.1 (k + 1)).1} ∩
        {q | (fseq q.1.1 x q.2.1 k).2 = y}) := by
    ext ⟨⟨ν, hν⟩, a, r⟩
    simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_iUnion, Set.mem_inter_iff,
      Set.mem_ofPred_eq]
    constructor
    · intro h
      obtain ⟨k, h1, h2⟩ := exists_block hν x a r
      exact ⟨k, ⟨h1, h2⟩, (fwdTraj_eq_fseq hν x a r h1 h2).symm.trans h⟩
    · rintro ⟨k, ⟨h1, h2⟩, h3⟩
      exact (fwdTraj_eq_fseq hν x a r h1 h2).trans h3
  rw [this]
  refine MeasurableSet.iUnion fun k => ?_
  refine ((measurableSet_le ((hF k).fst) hM).inter (measurableSet_lt hM ((hF (k + 1)).fst))).inter
    (measurableSet_eq_fun (hF k).snd measurable_const)

/-- Consumer form: the forward trajectory process as a measurable function of the configuration,
into the product σ-algebra. -/
theorem measurable_trajProc (x : Fin d → ℤ) (a : ℝ) :
    Measurable fun ν : Measure (RingSpace d β) => trajProc ν x a := by
  refine measurable_pi_iff.mpr fun s => ?_
  classical
  have hg : Measurable (fun ν : GoodSet d β => fwdTraj ν.2 x a (a + s)) :=
    (measurable_fwdTraj x).comp (measurable_id.prodMk (measurable_const.prodMk measurable_const))
  have key : (fun ν : Measure (RingSpace d β) => trajProc ν x a s) =
      fun ν => if h : ν ∈ {ν | Good ν} then fwdTraj h x a (a + s) else x := by
    funext ν
    by_cases h : Good ν
    · simp only [trajProc_of_good h, Set.mem_ofPred_eq, h, dite_eq_left]
      simp [fwdTraj, fwdReal]
    · simp [trajProc, h]
  rw [key]
  exact Measurable.dite (s := {ν : Measure (RingSpace d β) | Good ν}) hg
    (g := fun _ => x) measurable_const measurableSet_good

end ElboimSly.Cyclic

end
