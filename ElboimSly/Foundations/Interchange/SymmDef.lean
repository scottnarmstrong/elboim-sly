module

public import ElboimSly.Foundations.Interchange.Swap
import Mathlib

/-!
# Lattice and time symmetries of ring configurations

Lattice and time symmetries.

A lattice symmetry is a bijection of `ℤᵈ` preserving adjacency (this contains the group `G_d`
generated by translations, coordinate permutations and coordinate reflections; see
`LatticeGroup`). It acts on edges, hence on the ring space by `(e, θ) ↦ (g e, θ)`. A rotation and
the reflection act on the circle coordinate. The action on configurations is the pushforward.
-/

@[expose] public section

open MeasureTheory

namespace ElboimSly.Interchange

variable {d : ℕ} {β : ℝ} [Fact (0 < β)]

/-- A graph automorphism of `ℤᵈ` (Lattice and time symmetries, the group `G_d` acts through these). -/
structure LatticeAut (d : ℕ) where
  /-- The underlying bijection of vertices. -/
  toEquiv : (Fin d → ℤ) ≃ (Fin d → ℤ)
  /-- It preserves adjacency in both directions. -/
  adj : ∀ u v, LatticeAdj d (toEquiv u) (toEquiv v) ↔ LatticeAdj d u v

namespace LatticeAut

/-- The inverse automorphism. -/
def symm (g : LatticeAut d) : LatticeAut d where
  toEquiv := g.toEquiv.symm
  adj u v := by
    rw [← g.adj]
    simp

end LatticeAut

/-- The action of a lattice automorphism on edges. -/
def edgeEquiv (g : LatticeAut d) : Edge d ≃ Edge d where
  toFun e := ⟨Sym2.map g.toEquiv e.1, by
    obtain ⟨u, v, h, hadj⟩ := e.2
    exact ⟨g.toEquiv u, g.toEquiv v, by rw [h]; rfl, (g.adj u v).mpr hadj⟩⟩
  invFun e := ⟨Sym2.map g.toEquiv.symm e.1, by
    obtain ⟨u, v, h, hadj⟩ := e.2
    exact ⟨g.toEquiv.symm u, g.toEquiv.symm v, by rw [h]; rfl, (g.symm.adj u v).mpr hadj⟩⟩
  left_inv e := Subtype.ext (by simp [Sym2.map_map])
  right_inv e := Subtype.ext (by simp [Sym2.map_map])

theorem edgeEquiv_val (g : LatticeAut d) (e : Edge d) :
    (edgeEquiv g e).1 = Sym2.map g.toEquiv e.1 := rfl

theorem edgeEquiv_mem (g : LatticeAut d) (e : Edge d) (z : Fin d → ℤ) :
    (edgeEquiv g e).Mem (g.toEquiv z) ↔ e.Mem z := by
  unfold Edge.Mem
  rw [edgeEquiv_val, Sym2.mem_map]
  simp [g.toEquiv.injective.eq_iff]

/-- A measurable equivalence of the ring space acting by `σ` on edges and `τ` on the circle. -/
def ringMapEquiv (σ : Edge d ≃ Edge d) (τ : AddCircle β ≃ᵐ AddCircle β) :
    RingSpace d β ≃ᵐ RingSpace d β :=
  MeasurableEquiv.prodCongr ⟨σ, measurable_from_top, measurable_from_top⟩ τ

/-- The pushforward of a configuration under `(e, θ) ↦ (σ e, τ θ)`. -/
noncomputable def ringPush (σ : Edge d ≃ Edge d) (τ : AddCircle β ≃ᵐ AddCircle β)
    (ν : Measure (RingSpace d β)) : Measure (RingSpace d β) :=
  ν.map (ringMapEquiv σ τ)

omit [Fact (0 < β)] in
theorem ringMapEquiv_apply (σ : Edge d ≃ Edge d) (τ : AddCircle β ≃ᵐ AddCircle β)
    (p : RingSpace d β) : ringMapEquiv σ τ p = (σ p.1, τ p.2) := rfl

omit [Fact (0 < β)] in
theorem ringPush_apply (σ : Edge d ≃ Edge d) (τ : AddCircle β ≃ᵐ AddCircle β)
    (ν : Measure (RingSpace d β)) (A : Set (RingSpace d β)) :
    ringPush σ τ ν A = ν (ringMapEquiv σ τ ⁻¹' A) :=
  MeasurableEquiv.map_apply _ _

omit [Fact (0 < β)] in
theorem ringPush_singleton (σ : Edge d ≃ Edge d) (τ : AddCircle β ≃ᵐ AddCircle β)
    (ν : Measure (RingSpace d β)) (e : Edge d) (θ : AddCircle β) :
    ringPush σ τ ν {(e, θ)} = ν {(σ.symm e, τ.symm θ)} := by
  rw [ringPush_apply]
  congr 1
  ext p
  simp only [Set.mem_preimage, Set.mem_singleton_iff, ringMapEquiv_apply]
  constructor
  · intro h
    ext
    · exact (σ.eq_symm_apply).mpr (congrArg Prod.fst h)
    · exact (τ.eq_symm_apply).mpr (congrArg Prod.snd h)
  · rintro rfl
    simp

omit [Fact (0 < β)] in
theorem ringPush_edge_univ (σ : Edge d ≃ Edge d) (τ : AddCircle β ≃ᵐ AddCircle β)
    (ν : Measure (RingSpace d β)) (e : Edge d) :
    ringPush σ τ ν ({e} ×ˢ Set.univ) = ν ({σ.symm e} ×ˢ Set.univ) := by
  rw [ringPush_apply]
  congr 1
  ext p
  simp [ringMapEquiv_apply, σ.eq_symm_apply]

omit [Fact (0 < β)] in
theorem mem_ringSet_ringPush (σ : Edge d ≃ Edge d) (τ : AddCircle β ≃ᵐ AddCircle β)
    (ν : Measure (RingSpace d β)) (e : Edge d) (θ : AddCircle β) :
    θ ∈ ringSet (ringPush σ τ ν) e ↔ τ.symm θ ∈ ringSet ν (σ.symm e) := by
  unfold ringSet
  simp only [Set.mem_ofPred_eq, ringPush_singleton]

omit [Fact (0 < β)] in
theorem rings_ringPush (σ : Edge d ≃ Edge d) (τ : AddCircle β ≃ᵐ AddCircle β)
    (ν : Measure (RingSpace d β)) (e : Edge d) (t : ℝ) :
    Rings (ringPush σ τ ν) e t ↔ τ.symm (t : AddCircle β) ∈ ringSet ν (σ.symm e) :=
  mem_ringSet_ringPush σ τ ν e _

/-- `g_* ν`, the action of a lattice automorphism on configurations. -/
noncomputable def latticeMeasure (g : LatticeAut d) (ν : Measure (RingSpace d β)) :
    Measure (RingSpace d β) :=
  ringPush (edgeEquiv g) (MeasurableEquiv.refl _) ν

/-- `(ρ_r)_* ν`, the rotation of the circle coordinate by `[r]`. -/
noncomputable def rotateMeasure (r : ℝ) (ν : Measure (RingSpace d β)) :
    Measure (RingSpace d β) :=
  ringPush (Equiv.refl _) (MeasurableEquiv.addRight ((r : ℝ) : AddCircle β)) ν

variable (β) in
/-- `ϱ_* ν`, the reflection `θ ↦ -θ` of the circle coordinate. -/
noncomputable def reflectMeasure (ν : Measure (RingSpace d β)) : Measure (RingSpace d β) :=
  ringPush (Equiv.refl _) (MeasurableEquiv.neg (AddCircle β)) ν

omit [Fact (0 < β)] in
theorem rings_latticeMeasure (g : LatticeAut d) (ν : Measure (RingSpace d β)) (e : Edge d)
    (t : ℝ) : Rings (latticeMeasure g ν) (edgeEquiv g e) t ↔ Rings ν e t := by
  unfold latticeMeasure
  rw [rings_ringPush]
  simp [Rings]

omit [Fact (0 < β)] in
theorem rings_rotateMeasure (r : ℝ) (ν : Measure (RingSpace d β)) (e : Edge d) (t : ℝ) :
    Rings (rotateMeasure r ν) e t ↔ Rings ν e (t - r) := by
  unfold rotateMeasure
  rw [rings_ringPush]
  simp [Rings, sub_eq_add_neg]

omit [Fact (0 < β)] in
theorem rings_reflectMeasure (ν : Measure (RingSpace d β)) (e : Edge d) (t : ℝ) :
    Rings (reflectMeasure β ν) e t ↔ Rings ν e (-t) := by
  unfold reflectMeasure
  rw [rings_ringPush]
  simp [Rings]

end ElboimSly.Interchange
