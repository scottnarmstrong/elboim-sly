/-!
# Count calculus: independence of rectangle `σ`-algebras

Count calculus (b), (c), (d).

For a random measure `N` on `D × ℝ` and `U ⊆ D × ℝ`, `rectSigma N U` is the `σ`-algebra `𝒩_U`
generated by the rectangle counts `N({v} × I)`, `I ⊆ (0,∞)` a bounded interval, `{v} × I ⊆ U`.
`measSigma N U` is the larger `σ`-algebra generated by all counts `N(R)` of measurable `R ⊆ U`.

* `iIndep_measSigma`: the `σ`-algebras `measSigma N (U k)` of a Poisson point process over
  pairwise disjoint sets `U k` are independent (no measurability of `U k` is needed).
* `iIndepFun_rect_families`: (b), families of rectangle counts, disjoint across families.
* `iIndep_rectSigma_option`: (c), including an independent `σ`-algebra `𝒢₀`.
* `modNull`, `iIndep_modNull`: (d), the `σ`-algebra `ℬ^Γ` and its independence.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Set
open scoped ENNReal NNReal

namespace ElboimSly
namespace SRW

section Defs

variable {Ω D : Type*} [MeasurableSpace Ω] [MeasurableSpace D]

/-- A *rectangle interval*: a bounded interval (of any type, possibly empty or a point) inside
`(0,∞)`. A rectangle is `{v} × I` with `I` a rectangle interval. -/
def IsRectInterval (I : Set ℝ) : Prop :=
  I.OrdConnected ∧ Bornology.IsBounded I ∧ I ⊆ Ioi 0

/-- Count calculus: `𝒩_U`, generated by the counts of rectangles contained in `U`. -/
@[instance_reducible] def rectSigma (N : Ω → Measure (D × ℝ)) (U : Set (D × ℝ)) : MeasurableSpace Ω :=
  ⨆ (v : D) (I : Set ℝ) (_ : IsRectInterval I) (_ : ({v} : Set D) ×ˢ I ⊆ U),
    MeasurableSpace.comap (fun ω => N ω (({v} : Set D) ×ˢ I)) inferInstance

/-- The `σ`-algebra generated by the counts of all measurable subsets of `U`. -/
@[instance_reducible] def measSigma {S : Type*} [MeasurableSpace S] (N : Ω → Measure S) (U : Set S) :
    MeasurableSpace Ω :=
  ⨆ R ∈ {R : Set S | MeasurableSet R ∧ R ⊆ U},
    MeasurableSpace.comap (fun ω => N ω R) inferInstance

theorem IsRectInterval.measurableSet {I : Set ℝ} (h : IsRectInterval I) : MeasurableSet I :=
  h.1.measurableSet

omit [MeasurableSpace Ω] in
theorem rectSigma_le_top (N : Ω → Measure (D × ℝ)) (U : Set (D × ℝ)) :
    rectSigma N U ≤ rectSigma N (univ ×ˢ Ioi 0) := by
  refine iSup_le fun v => iSup_le fun I => iSup_le fun hI => iSup_le fun _ => ?_
  exact le_iSup_of_le v (le_iSup_of_le I (le_iSup_of_le hI (le_iSup_of_le
    (fun x hx => ⟨mem_univ _, hI.2.2 (mem_prod.1 hx).2⟩) le_rfl)))

variable [MeasurableSingletonClass D]

omit [MeasurableSpace Ω] in
theorem rectSigma_le_measSigma (N : Ω → Measure (D × ℝ)) (U : Set (D × ℝ)) :
    rectSigma N U ≤ measSigma N U := by
  refine iSup_le fun v => iSup_le fun I => iSup_le fun hI => iSup_le fun hU => ?_
  exact le_iSup₂_of_le (({v} : Set D) ×ˢ I) ⟨(measurableSet_singleton v).prod hI.measurableSet, hU⟩
    le_rfl

omit [MeasurableSpace Ω] [MeasurableSingletonClass D] in
/-- Every rectangle count is measurable for `𝒩_U`, if the rectangle lies in `U`. -/
theorem measurable_rect_count (N : Ω → Measure (D × ℝ)) (U : Set (D × ℝ)) (v : D) {I : Set ℝ}
    (hI : IsRectInterval I) (hU : ({v} : Set D) ×ˢ I ⊆ U) :
    Measurable[rectSigma N U] (fun ω => N ω (({v} : Set D) ×ˢ I)) := by
  have : MeasurableSpace.comap (fun ω => N ω (({v} : Set D) ×ˢ I)) inferInstance ≤
      rectSigma N U :=
    le_iSup_of_le v (le_iSup_of_le I (le_iSup_of_le hI (le_iSup_of_le hU le_rfl)))
  exact fun s hs => this _ ⟨s, hs, rfl⟩

end Defs

section Independence

variable {Ω S : Type*} [mΩ : MeasurableSpace Ω] [MeasurableSpace S] {N : Ω → Measure S}
  {μ : Measure S} {P : Measure Ω}

theorem measSigma_le (hN : Measurable N) (U : Set S) : measSigma N U ≤ mΩ :=
  iSup₂_le fun _R hR => ((Measure.measurable_coe hR.1).comp hN).comap_le

/-- Monotonicity of `iIndep` in the `σ`-algebras. -/
theorem iIndep_mono {ι : Type*} {m m' : ι → MeasurableSpace Ω} (h : iIndep m P)
    (hle : ∀ i, m' i ≤ m i) : iIndep m' P := by
  rw [iIndep_iff] at h ⊢
  intro s f hf
  exact h s fun i hi => hle i _ (hf i hi)

/-- The `σ`-algebras generated by the counts of measurable subsets of pairwise disjoint sets are
independent. -/
theorem iIndep_measSigma (hN : IsPoissonPointProcess N μ P) {κ : Type*} (U : κ → Set S)
    (hd : Pairwise (Function.onFun Disjoint U)) : iIndep (fun k => measSigma N (U k)) P := by
  classical
  refine iIndep_of_pi_systems (fun k => measSigma_le hN.measurable _)
    (fun k => piiUnionInter (fun R : Set S =>
      {s | MeasurableSet[MeasurableSpace.comap (fun ω => N ω R) inferInstance] s})
      {R : Set S | MeasurableSet R ∧ R ⊆ U k})
    (fun k => isPiSystem_piiUnionInter _
      (fun R => @MeasurableSpace.isPiSystem_measurableSet _
        (MeasurableSpace.comap (fun ω => N ω R) inferInstance)) _)
    (fun k => (generateFrom_piiUnionInter_measurableSet
      (fun R : Set S => MeasurableSpace.comap (fun ω => N ω R) inferInstance)
      {R : Set S | MeasurableSet R ∧ R ⊆ U k}).symm) ?_
  intro J f hf
  choose! t htJ g hg hfeq using hf
  set A : κ → Set S := fun k => if k ∈ J then ⋃ R ∈ t k, R else ∅ with hA
  have hAmeas : ∀ k, MeasurableSet (A k) := by
    intro k
    by_cases hk : k ∈ J
    · simp only [hA, ite_eq_left hk]
      exact Finset.measurableSet_biUnion _ fun R hR => (htJ k hk hR).1
    · simp [hA, hk]
  have hAdis : Pairwise (Function.onFun Disjoint A) := by
    intro k k' hkk'
    by_cases hk : k ∈ J
    · by_cases hk' : k' ∈ J
      · simp only [Function.onFun, hA, ite_eq_left hk, ite_eq_left hk']
        refine Set.disjoint_left.2 fun x hx hx' => ?_
        simp only [mem_iUnion] at hx hx'
        obtain ⟨R, hR, hxR⟩ := hx
        obtain ⟨R', hR', hxR'⟩ := hx'
        exact Set.disjoint_left.1 (hd hkk') ((htJ k hk hR).2 hxR) ((htJ k' hk' hR').2 hxR')
      · simp [Function.onFun, hA, hk']
    · simp [Function.onFun, hA, hk]
  have hind := hN.iIndepFun_restrict hAmeas hAdis
  rw [iIndepFun_iff_iIndep] at hind
  have hmeas : ∀ k ∈ J, MeasurableSet[MeasurableSpace.comap
      (fun ω => (N ω).restrict (A k)) inferInstance] (f k) := by
    intro k hk
    rw [hfeq k hk]
    refine @Finset.measurableSet_biInter _ _ (MeasurableSpace.comap
      (fun ω => (N ω).restrict (A k)) inferInstance) _ _ fun R hR => ?_
    have hRA : R ⊆ A k := by
      simp only [hA, ite_eq_left hk]
      exact subset_biUnion_of_mem (u := fun R => R) hR
    have hle : MeasurableSpace.comap (fun ω => N ω R) inferInstance ≤
        MeasurableSpace.comap (fun ω => (N ω).restrict (A k)) inferInstance := by
      have e : (fun ω => N ω R) =
          (fun m : Measure S => m R) ∘ (fun ω => (N ω).restrict (A k)) := by
        funext ω
        simp only [Function.comp]
        rw [Measure.restrict_apply (htJ k hk hR).1, inter_eq_left.2 hRA]
      rw [e, ← MeasurableSpace.comap_comp]
      exact MeasurableSpace.comap_mono (Measure.measurable_coe (htJ k hk hR).1).comap_le
    exact hle _ (hg k hk R hR)
  have key := hind.meas_biInter (S := J) (s := f) hmeas
  exact key

/-- Count calculus (b): families of rectangle counts, with rectangles of different
families disjoint, are independent (rectangles inside one family may overlap). -/
theorem iIndepFun_rect_families [MeasurableSingletonClass S] {D : Type*} [MeasurableSpace D]
    [MeasurableSingletonClass D] {N : Ω → Measure (D × ℝ)} {μ : Measure (D × ℝ)}
    (hN : IsPoissonPointProcess N μ P) {κ : Type*} (J : κ → Finset (D × Set ℝ))
    (hJ : ∀ l, ∀ r ∈ J l, IsRectInterval r.2)
    (hdis : ∀ l l', l ≠ l' → ∀ r ∈ J l, ∀ r' ∈ J l',
      Disjoint (({r.1} : Set D) ×ˢ r.2) (({r'.1} : Set D) ×ˢ r'.2)) :
    iIndepFun (fun (l : κ) (ω : Ω) (r : J l) => N ω (({r.1.1} : Set D) ×ˢ r.1.2)) P := by
  rw [iIndepFun_iff_iIndep]
  set U : κ → Set (D × ℝ) := fun l => ⋃ r ∈ J l, ({r.1} : Set D) ×ˢ r.2 with hU
  have hUd : Pairwise (Function.onFun Disjoint U) := by
    intro l l' hll'
    refine Set.disjoint_left.2 fun x hx hx' => ?_
    simp only [hU, mem_iUnion] at hx hx'
    obtain ⟨r, hr, hxr⟩ := hx
    obtain ⟨r', hr', hxr'⟩ := hx'
    exact Set.disjoint_left.1 (hdis l l' hll' r hr r' hr') hxr hxr'
  refine iIndep_mono (iIndep_measSigma hN U hUd) fun l => ?_
  have hm : Measurable[measSigma N (U l)] (fun ω (r : J l) =>
      N ω (({r.1.1} : Set D) ×ˢ r.1.2)) := by
    let : MeasurableSpace Ω := measSigma N (U l)
    refine measurable_pi_iff.2 fun r => ?_
    have hR : MeasurableSet (({r.1.1} : Set D) ×ˢ r.1.2) :=
      (measurableSet_singleton _).prod (hJ l r.1 r.2).measurableSet
    have hsub : (({r.1.1} : Set D) ×ˢ r.1.2) ⊆ U l :=
      subset_biUnion_of_mem (u := fun r : D × Set ℝ => ({r.1} : Set D) ×ˢ r.2) r.2
    have : MeasurableSpace.comap (fun ω => N ω (({r.1.1} : Set D) ×ˢ r.1.2)) inferInstance ≤
        measSigma N (U l) :=
      le_iSup₂_of_le (({r.1.1} : Set D) ×ˢ r.1.2) ⟨hR, hsub⟩ le_rfl
    exact fun s hs => this _ ⟨s, hs, rfl⟩
  exact Measurable.comap_le hm

/-- Count calculus (c): the `σ`-algebras `𝒢₀, 𝒩_{U₁}, 𝒩_{U₂}, …` are independent for
pairwise disjoint `Uᵢ` and `𝒢₀` independent of `𝒩`. -/
theorem iIndep_rectSigma_option [MeasurableSingletonClass S] {D : Type*} [MeasurableSpace D]
    [MeasurableSingletonClass D] {N : Ω → Measure (D × ℝ)} {μ : Measure (D × ℝ)}
    (hN : IsPoissonPointProcess N μ P) {ι : Type*} (U : ι → Set (D × ℝ))
    (hd : Pairwise (Function.onFun Disjoint U)) {β : Type*} [MeasurableSpace β] (W : Ω → β)
    (hG0 : Indep (MeasurableSpace.comap W inferInstance) (rectSigma N (univ ×ˢ Ioi 0)) P) :
    iIndep (fun i : Option ι => i.elim (MeasurableSpace.comap W inferInstance)
      (fun j => rectSigma N (U j))) P := by
  classical
  have hbase : iIndep (fun j => rectSigma N (U j)) P :=
    iIndep_mono (iIndep_measSigma hN U hd) fun j => rectSigma_le_measSigma N (U j)
  rw [iIndep_iff]
  intro s f hf
  set s' : Finset ι := s.eraseNone with hs'
  have hG : MeasurableSet[rectSigma N (univ ×ˢ Ioi 0)] (⋂ j ∈ s', f (some j)) := by
    refine @Finset.measurableSet_biInter _ _ (rectSigma N (univ ×ˢ Ioi 0)) _ _ fun j hj => ?_
    exact rectSigma_le_top N (U j) _ (hf (some j) (Finset.mem_eraseNone.1 hj))
  have hPG : P (⋂ j ∈ s', f (some j)) = ∏ j ∈ s', P (f (some j)) :=
    hbase.meas_biInter (S := s') (s := fun j => f (some j))
      fun j hj => hf (some j) (Finset.mem_eraseNone.1 hj)
  by_cases h0 : none ∈ s
  · have hs : s = Finset.insertNone s' := by
      rw [hs', Finset.insertNone_eraseNone, Finset.insert_eq_of_mem h0]
    have e : (⋂ i ∈ s, f i) = f none ∩ ⋂ j ∈ s', f (some j) := by
      ext ω
      simp only [mem_iInter, mem_inter_iff]
      constructor
      · intro h
        exact ⟨h none h0, fun j hj => h (some j) (Finset.mem_eraseNone.1 hj)⟩
      · rintro ⟨h1, h2⟩ i hi
        cases i with
        | none => exact h1
        | some j => exact h2 j (Finset.mem_eraseNone.2 hi)
    rw [e, (Indep_iff _ _ _).1 hG0 _ _ (hf none h0) hG, hPG]
    conv_rhs => rw [hs, Finset.prod_insertNone]
  · have hs : s = s'.map Function.Embedding.some := by
      rw [hs', Finset.map_some_eraseNone, Finset.erase_eq_of_notMem h0]
    have e : (⋂ i ∈ s, f i) = ⋂ j ∈ s', f (some j) := by
      ext ω
      simp only [mem_iInter]
      constructor
      · intro h j hj
        exact h (some j) (Finset.mem_eraseNone.1 hj)
      · intro h i hi
        cases i with
        | none => exact absurd hi h0
        | some j => exact h j (Finset.mem_eraseNone.2 hi)
    rw [e, hPG]
    conv_rhs => rw [hs, Finset.prod_map]
    rfl

end Independence

section NullMod

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω}

/-- Count calculus (d): `ℬ^Γ = {A ∈ 𝒜 : A ∩ Γ = B ∩ Γ for some B ∈ ℬ}`. -/
@[instance_reducible] def modNull (Γ : Set Ω) (B : MeasurableSpace Ω) : MeasurableSpace Ω where
  MeasurableSet' A := MeasurableSet[mΩ] A ∧ ∃ B', MeasurableSet[B] B' ∧ A ∩ Γ = B' ∩ Γ
  measurableSet_empty := ⟨@MeasurableSet.empty _ mΩ, ∅, @MeasurableSet.empty _ B, rfl⟩
  measurableSet_compl := by
    rintro A ⟨hA, B', hB', h⟩
    refine ⟨@MeasurableSet.compl _ _ mΩ hA, B'ᶜ, @MeasurableSet.compl _ _ B hB', ?_⟩
    ext x
    simp only [mem_inter_iff, mem_compl_iff]
    constructor
    · rintro ⟨h1, h2⟩
      refine ⟨fun h3 => h1 ?_, h2⟩
      have : x ∈ B' ∩ Γ := ⟨h3, h2⟩
      rw [← h] at this
      exact this.1
    · rintro ⟨h1, h2⟩
      refine ⟨fun h3 => h1 ?_, h2⟩
      have : x ∈ A ∩ Γ := ⟨h3, h2⟩
      rw [h] at this
      exact this.1
  measurableSet_iUnion := by
    intro f hf
    choose hfm B' hB' h using hf
    refine ⟨@MeasurableSet.iUnion _ _ mΩ _ _ hfm, ⋃ n, B' n, @MeasurableSet.iUnion _ _ B _ _ hB', ?_⟩
    rw [iUnion_inter, iUnion_inter]
    exact iUnion_congr h

/-- Count calculus (d): if `P(Γ) = 1` and `ℬ₁, ℬ₂, …` are independent, so are
`ℬ₁^Γ, ℬ₂^Γ, …`. -/
theorem iIndep_modNull {ι : Type*} {B : ι → MeasurableSpace Ω} (_hB : ∀ i, B i ≤ mΩ)
    (hind : iIndep B P) {Γ : Set Ω} (hP : P Γᶜ = 0) : iIndep (fun i => modNull Γ (B i)) P := by
  rw [iIndep_iff] at hind ⊢
  intro s f hf
  have hex : ∀ i ∈ s, ∃ g, MeasurableSet[B i] g ∧ f i ∩ Γ = g ∩ Γ := fun i hi => (hf i hi).2
  choose! g hg hfg using hex
  have hPf : ∀ i ∈ s, P (f i) = P (g i) := by
    intro i hi
    rw [← measure_inter_conull hP (s := f i), hfg i hi, measure_inter_conull hP]
  have e : (⋂ i ∈ s, f i) ∩ Γ = (⋂ i ∈ s, g i) ∩ Γ := by
    ext x
    simp only [mem_inter_iff, mem_iInter]
    constructor
    · rintro ⟨h1, hx⟩
      refine ⟨fun i hi => ?_, hx⟩
      have : x ∈ g i ∩ Γ := by rw [← hfg i hi]; exact ⟨h1 i hi, hx⟩
      exact this.1
    · rintro ⟨h1, hx⟩
      refine ⟨fun i hi => ?_, hx⟩
      have : x ∈ f i ∩ Γ := by rw [hfg i hi]; exact ⟨h1 i hi, hx⟩
      exact this.1
  rw [← measure_inter_conull hP (s := ⋂ i ∈ s, f i), e, measure_inter_conull hP,
    hind s hg]
  exact Finset.prod_congr rfl fun i hi => (hPf i hi).symm

end NullMod

