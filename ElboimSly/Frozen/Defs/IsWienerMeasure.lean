module

public import Mathlib.Basic.Real.Basic
public import Mathlib.MeasureTheory.Constructions.BorelSpace.ContinuousMap
public import Mathlib.Probability.BrownianMotion.Basic
public import Mathlib.Probability.Independence.Basic

/-!
# IsWienerMeasure

Standard d-dimensional Brownian motion; The law of Brownian motion (b) (Wiener measure).
-/

public section

open MeasureTheory ProbabilityTheory
open scoped NNReal

namespace ElboimSly

/-- `𝕎` is Wiener measure on `C([0, ∞), ℝ^d)` (Borel `σ`-algebra of the compact-open topology,
`ContinuousMap.measurableSpace`): a probability measure under which each coordinate process
`(t, w) ↦ w t i` is pre-Brownian (Mathlib's `IsPreBrownianReal`; (BM2) of standard d-dimensional Brownian motion) and the `d`
coordinate processes are mutually independent ((BM3)). (BM0) and the continuity part of (BM1) hold
for every element of `C([0, ∞), ℝ^d)`. The condition `w 0 = 0` holds `𝕎`-almost surely
(`IsPreBrownianReal.eval_zero_ae_eq_zero`); it is not, and cannot be, demanded for every `w`, since
the canonical space contains paths with `w 0 ≠ 0`. The finite-dimensional laws are thereby fixed,
and they determine `𝕎`, because the Borel `σ`-algebra of `C([0, ∞), ℝ^d)` is generated by the
evaluations (`ContinuousMap.borel_eq_iSup_comap_eval`). Standard d-dimensional Brownian motion; The law of Brownian motion (b). -/
@[expose] def IsWienerMeasure (d : ℕ) (𝕎 : Measure C(ℝ≥0, Fin d → ℝ)) : Prop :=
  IsProbabilityMeasure 𝕎 ∧
  (∀ i, IsPreBrownianReal (fun t (w : C(ℝ≥0, Fin d → ℝ)) => w t i) 𝕎) ∧
  iIndepFun (fun i (w : C(ℝ≥0, Fin d → ℝ)) t => w t i) 𝕎

end ElboimSly

end
