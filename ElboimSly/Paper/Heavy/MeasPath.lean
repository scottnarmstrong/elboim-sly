module

public import ElboimSly.Paper.Heavy.MeasStop5

/-!
# Measurability on the space of cyclic paths

Measurability (d).

`CycPathSpace d` is the space of cyclic paths with the `σ`-algebra generated by the evaluations
`w ↦ w s`, `s ≥ 0`, and `cycPathFiltration` is its natural filtration.  The identity path is
`AdaptedCyclic`, so every stopping-time result of the previous files gives measurability of the
corresponding functional of the path: `ξ_A`, `s_i(B)`, `τ'(B)`, `τ'`, `τ_fast`, `τ_jump`, `T(w)`.
-/

@[expose] public section

open MeasureTheory Set
open scoped ENNReal NNReal

namespace ElboimSly.Paper

open ElboimSly

/-- The space of cyclic paths. -/
abbrev CycPathSpace (d : ℕ) : Type := {w : ℝ → Fin d → ℤ // IsCyclicPath w}

instance (d : ℕ) : MeasurableSpace (CycPathSpace d) :=
  ⨆ s : ℝ≥0, MeasurableSpace.comap (fun p : CycPathSpace d => p.1 s) inferInstance

variable {d : ℕ}

/-- The natural filtration of the space of cyclic paths. -/
def cycPathFiltration (d : ℕ) : Filtration ℝ≥0 (inferInstance : MeasurableSpace (CycPathSpace d)) where
  seq t := ⨆ s : {s : ℝ≥0 // s ≤ t},
    MeasurableSpace.comap (fun p : CycPathSpace d => p.1 s) inferInstance
  mono' _a _b hab := iSup_mono' fun s => ⟨⟨s.1, s.2.trans hab⟩, le_rfl⟩
  le' _t := iSup_le fun s => le_iSup
    (fun s : ℝ≥0 => MeasurableSpace.comap (fun p : CycPathSpace d => p.1 s) inferInstance) s.1

/-- The canonical process is adapted to the natural filtration. -/
theorem adaptedCyclic_cycPathSpace :
    AdaptedCyclic (cycPathFiltration d) (fun (p : CycPathSpace d) => p.1) where
  path p := p.2
  adapted s := (comap_measurable (fun p : CycPathSpace d => p.1 (s : ℝ))).mono
    (le_iSup (fun u : {u : ℝ≥0 // u ≤ s} =>
      MeasurableSpace.comap (fun p : CycPathSpace d => p.1 u) inferInstance) ⟨s, le_rfl⟩) le_rfl

theorem measurable_heavyTauPrime_cycPath (t₀ : ℝ) {n : ℕ} (hn : 1 ≤ n) :
    Measurable (fun p : CycPathSpace d => heavyTauPrime d t₀ n p.1) :=
  (adaptedCyclic_cycPathSpace.isStoppingTime_heavyTauPrime (t₀ := t₀) hn).measurable'

theorem measurable_pathTfast_cycPath {L : ℝ} (hL : 0 < L) :
    Measurable (fun p : CycPathSpace d => pathTfast p.1 L) :=
  (adaptedCyclic_cycPathSpace.isStoppingTime_pathTfast hL).measurable'

theorem measurable_pathTjump_cycPath {L : ℝ} (hL : 0 < L) :
    Measurable (fun p : CycPathSpace d => pathTjump p.1 L) :=
  (adaptedCyclic_cycPathSpace.isStoppingTime_pathTjump hL).measurable'

theorem measurable_cycClosingTime_cycPath {β : ℝ} (hβ : 0 < β) :
    Measurable (fun p : CycPathSpace d => cycClosingTime β p.1) :=
  (adaptedCyclic_cycPathSpace.isStoppingTime_cycClosingTime hβ).measurable'

end ElboimSly.Paper
