import Lake

open Lake DSL

package «elboimSly» where

require mathlib from git
  "https://github.com/leanprover-community/mathlib4.git" @ "v4.35.0"

private def projectLeanOptions : Array LeanOption := #[
  ⟨`autoImplicit, false⟩,
  ⟨`relaxedAutoImplicit, false⟩,
  ⟨`linter.unusedVariables, true⟩,
  ⟨`linter.unusedSectionVars, true⟩,
  ⟨`linter.deprecated, true⟩
]

/-- The formalization: the seven main theorems and the definitions they use (`ElboimSly.Frozen`, one
declaration per file), their proofs (`ElboimSly.Provider`, `ElboimSly.Paper`) and the inputs
(`ElboimSly.Foundations`). The root `ElboimSly.lean` imports every module. -/
@[default_target]
lean_lib «ElboimSly» where
  roots := #[`ElboimSly]
  globs := #[.one `ElboimSly]
  leanOptions := projectLeanOptions

/-- The comparator challenge: the main statements with every definition they use, from Mathlib only
(`Challenge.lean`, generated by `scripts/build_challenge.py`), their proofs from this library
(`Solution.lean`) and the axiom audit. Check with `scripts/verify_comparator.sh`. -/
lean_lib «ElboimSlyChallenges» where
  globs := #[.submodules `ElboimSlyChallenges]
